# AERIS configuration. Copy to .env and edit. Never commit real credentials.

AERIS_ENV=development                 # development | test | production
AERIS_FLEET_PROVIDER=fake             # fake | px4        (px4 is Phase 4, Docker-hosted)
AERIS_DECISION_PROVIDER=mock          # mock | rules | openrouter | typesafe
AERIS_DECISION_FALLBACK=rules         # offline provider used when the hosted one fails

# Jev (TypeSafe AI) via OpenRouter, the default hosted path. OpenRouter is only the gateway;
# Jev is the decision model. Required only when AERIS_DECISION_PROVIDER=openrouter.
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-latest

# Direct TypeSafe API (optional alternative). Required only when AERIS_DECISION_PROVIDER=typesafe.
TYPESAFE_API_KEY=

# Persistence. Leave empty to use the in-memory repository (default for local dev and tests).
# Example: postgresql+asyncpg://aeris:aeris@localhost:5432/aeris
DATABASE_URL=

# Safety thresholds (named, with units). Defaults live in backend/aeris/config.py.
# AERIS_SAFETY__MIN_RETURN_BATTERY_PERCENT=25
# AERIS_SAFETY__CRITICAL_BATTERY_PERCENT=15
# AERIS_SAFETY__LINK_DEGRADED_AFTER_S=2
# AERIS_SAFETY__LINK_STALE_AFTER_S=5
# AERIS_SAFETY__LINK_LOST_AFTER_S=10
